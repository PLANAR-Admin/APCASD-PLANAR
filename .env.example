# APCASD PLANAR Website - Environment Configuration
# Copy this file to .env.local and fill in production values
# DO NOT commit .env files with real values to Git

# ==============================================
# ADMIN AUTHENTICATION
# ==============================================
# Set a strong admin password for the admin dashboard
# Minimum 12 characters, mix of uppercase, lowercase, numbers, and symbols
# This is hashed with PBKDF2 for secure storage
ADMIN_PASSWORD=your-secure-admin-password-here-change-in-production

# ==============================================
# ENVIRONMENT
# ==============================================
NODE_ENV=production

# ==============================================
# SECURITY NOTES
# ==============================================
# 1. Never commit this file with real values
# 2. Add .env to .gitignore  
# 3. Use a secrets manager in production (not environment files)
# 4. Rotate ADMIN_PASSWORD periodically
# 5. Monitor login attempts for suspicious activity
# 6. Ensure HTTPS is enabled in production
# 7. Maintain automated backups of all data files
# 8. Review security logs regularly
